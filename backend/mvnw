#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup script (Unix / macOS / Linux)
#
# NOTE: This project ships pom.xml + this wrapper script for convenience.
# The wrapper downloads Maven automatically from repo.maven.apache.org the
# first time it runs (internet connection required). If you prefer, you can
# simply open the `backend` folder in IntelliJ IDEA and use its bundled
# Maven instead - no wrapper needed.
# ----------------------------------------------------------------------------

set -e

BASE_DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
  WRAPPER_URL=$(grep '^wrapperUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
  echo "Downloading Maven Wrapper from: $WRAPPER_URL"
  if command -v curl >/dev/null 2>&1; then
    curl -o "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "ERROR: Neither curl nor wget is available to download the Maven Wrapper jar."
    echo "Please install Maven manually, or open this project in IntelliJ IDEA (bundled Maven)."
    exit 1
  fi
fi

JAVA_EXE="java"
if [ -n "$JAVA_HOME" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
fi

exec "$JAVA_EXE" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
